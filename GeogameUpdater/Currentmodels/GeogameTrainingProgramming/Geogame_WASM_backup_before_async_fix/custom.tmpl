      document.getElementById('btn-rw-no').textContent = (language === 'en') ? "No" : "Όχι";

      showToast(language === 'en' ? 'Language: English' : 'Language: Greek');
    }

    function onPlay() {
      openModal('screen-levels');
    }

    function playLevel(levelIndex) {
      currentLevelIndex = levelIndex;
      closeModal('screen-levels');
      document.getElementById('main-menu').classList.remove('visible');

      populateScenarioText(levelIndex);
      document.getElementById('input-starting-q').value = '';
      drawMiniGrid(levelIndex);
      openModal('screen-setup-q');
    }

    function drawMiniGrid(lvl) {
      var gridDiv = document.getElementById('mini-grid');
      gridDiv.innerHTML = '';
      for (var r = 0; r < 17; r++) {
        for (var c = 0; c < 17; c++) {
          var cell = document.createElement('div');
          cell.style.width = '16px';
          cell.style.height = '16px';
          cell.style.border = '1px solid rgba(0,0,0,0.1)';
          cell.style.boxSizing = 'border-box';
          cell.style.position = 'relative';
          cell.style.display = 'flex';
          cell.style.alignItems = 'center';
          cell.style.justifyContent = 'center';
          cell.id = 'mini-cell-' + r + '-' + c;
          gridDiv.appendChild(cell);
        }
      }

      function placeMini(r, c, img) {
        if (r < 0 || r >= 17 || c < 0 || c >= 17) return;
        var cell = document.getElementById('mini-cell-' + r + '-' + c);
        if (cell) cell.innerHTML = '<img src="./GameAssets/icons/' + img + '" style="width: 14px; height: 14px; object-fit: contain;">';
      }

      var data = GEODATA.info;
      // Pumping well
      if (data.pw_row[lvl] > 0) placeMini(data.pw_row[lvl], data.pw_col[lvl], 'icon15.png');
      // Houses
      if (data.house0_row[lvl] > 0) placeMini(data.house0_row[lvl], data.house0_col[lvl], 'icon12.png');
      if (data.house1_row[lvl] > 0) placeMini(data.house1_row[lvl], data.house1_col[lvl], 'icon12.png');
      if (data.house2_row[lvl] > 0) placeMini(data.house2_row[lvl], data.house2_col[lvl], 'icon12.png');
      // Greenhouses
      if (data.greenhouse0_row[lvl] > 0) placeMini(data.greenhouse0_row[lvl], data.greenhouse0_col[lvl], 'icon13.png');
      if (data.greenhouse1_row[lvl] > 0) placeMini(data.greenhouse1_row[lvl], data.greenhouse1_col[lvl], 'icon13.png');
      // Recharging well (rw is placed later if needed, but it exists in dataset)
      if (data.rw_row[lvl] > 0) placeMini(data.rw_row[lvl], data.rw_col[lvl], 'icon14.png');
    }

    function populateScenarioText(i) {
      var data = GEODATA.info;
      var q_h0 = data.Qhouse0_in[i];
      var q_h1 = data.Qhouse1_in[i];
      var q_h2 = data.Qhouse2_in[i];
      var q_gh0 = data.Qghouse0_in[i];
      var q_depl = data.Qtot_depl[i];
      var q_head = data.Qtot_head[i];

      var html = '';
      if (language === 'en') {
        html += '<p><strong>Complete the sketch of the heating system shown below. It\'s given that:</strong></p><br/>';
        html += '<p>1- The temperature of geothermal water is 85 &deg;C.</p>';
        html += '<p>2- Its quality is good.</p>';

        var reqHtml = '3- The required hot water supply is equal to ';
        var reqs = [];
        if (q_h0 > 0) reqs.push(q_h0 + ' for complex A');
        if (q_h1 > 0) reqs.push(q_h1 + ' for complex B');
        if (q_h2 > 0) reqs.push(q_h2 + ' for complex C');
        if (q_gh0 > 0) reqs.push(q_gh0 + ' for greenhouse.');
        reqHtml += reqs.join(', ') + '.';

        html += '<p>' + reqHtml + '</p>';
        html += '<p>4- There is no risk of depleting the aquifer if the total pumped supply Q&Sigma; is less than ' + q_depl + '.</p>';
        html += '<p>5- However, a significant drawdown in the piezometric load occurs if Q&Sigma; is greater than ' + q_head + '.</p>';
        html += '<p>6- The required input and output temperatures are shown in the diagram.</p>';
      } else {
        html += '<p><strong>Συμπληρώστε το σκαρίφημα του συστήματος θέρμανσης του σχήματος. Δίνεται ότι:</strong></p><br/>';
        html += '<p>1- Η θερμοκρασία του γεωθερμικού νερού είναι 85 &deg;C.</p>';
        html += '<p>2- Η ποιότητά του είναι καλή.</p>';

        var reqHtml = '3- Η απαιτούμενη παροχή θερμού νερού είναι ίση με ';
        var reqs = [];
        if (q_h0 > 0) reqs.push(q_h0 + ' για το συγκρότημα Α');
        if (q_h1 > 0) reqs.push(q_h1 + ' για το συγκρότημα Β');
        if (q_h2 > 0) reqs.push(q_h2 + ' για το συγκρότημα Γ');
        if (q_gh0 > 0) reqs.push(q_gh0 + ' για το θερμοκήπιο.');
        reqHtml += reqs.join(', ') + '.';

        html += '<p>' + reqHtml + '</p>';
        html += '<p>4- Δεν υπάρχει κίνδυνος εξάντλησης του υδροφορέα, αν η συνολικά αντλούμενη παροχή Q&Sigma; είναι μικρότερη από ' + q_depl + '.</p>';
        html += '<p>5- Προκαλείται όμως σημαντική πτώση στάθμης του πιεζομετρικού φορτίου, αν η Q&Sigma; είναι μεγαλύτερη από ' + q_head + '.</p>';
        html += '<p>6- Οι απαιτούμενες θερμοκρασίες εισόδου και εξόδου φαίνονται στο σχήμα.</p>';
      }
      document.getElementById('scenario-text-container').innerHTML = html;
    }

    function submitStartingQ() {
      var val = document.getElementById('input-starting-q').value;
      if (!val || isNaN(val) || parseInt(val) <= 0) {
        showToast(language === 'en' ? 'Please enter a valid number.' : 'Παρακαλώ εισάγετε έγκυρο αριθμό.');
        return;
      }
      userStartingQ = parseInt(val);
      closeModal('screen-setup-q');
      openModal('screen-setup-rw');
    }

    function submitRechargingWell(yesno) {
      useRechargingWell = yesno;
      closeModal('screen-setup-rw');
      showToast('Starting Game...');
      
      // Start WASM game seamlessly!
    document.getElementById('game-root').style.display = 'none';
    var canvas = document.getElementById('canvas');
    if(canvas) canvas.style.visibility = 'visible';
    
    window.gameLevel = currentLevelIndex;
    window.gameStartingQ = userStartingQ;
    window.gameHasRW = useRechargingWell ? 1 : 0;
    window.gameReady = true;
    
    // Trigger Pygbag's internal start mechanism
    setTimeout(function() {
        var dialog = document.getElementById("dialog");
        if (dialog) { 
            dialog.click(); 
        } else if (canvas) {
            canvas.dispatchEvent(new MouseEvent('click', {bubbles: true, cancelable: true}));
