    // Loading sequence
    (function runLoader() {
      var bar = document.getElementById('loading-bar');
      var caption = document.getElementById('loading-caption');
      var ls = document.getElementById('loading-screen');
      var menu = document.getElementById('main-menu');
      var steps = [
        { pct: 18, msg: 'Loading assets...' },
        { pct: 38, msg: 'Reading geodata...' },
        { pct: 56, msg: 'Building grid...' },
        { pct: 74, msg: 'Loading sounds...' },
        { pct: 92, msg: 'Almost ready...' },
        { pct: 100, msg: 'Done!' }
      ];
      var idx = 0;
      function next() {
        if (idx >= steps.length) {
          setTimeout(function () {
            ls.classList.add('hidden');
            menu.classList.add('visible');
            populateHighScores();
            populateLevelSelection();
          }, 400);
          return;
        }
        var step = steps[idx++];
        bar.style.width = step.pct + '%';
        caption.textContent = step.msg;
        var delay = (idx >= steps.length) ? 600 : (180 + Math.random() * 260);
        setTimeout(next, delay);
      }
      setTimeout(next, 350);
    })();

    function toggleLanguage() {
      language = (language === 'en') ? 'gr' : 'en';
      document.getElementById('lang-flag').innerHTML =
        language === 'en' ? '&#127468;&#127463;' : '&#127468;&#127479;';

      // Update scenario text if currently on the Q setup screen
      if (currentLevelIndex !== -1 && document.getElementById('screen-setup-q').classList.contains('visible')) {
        populateScenarioText(currentLevelIndex);
      }
      // Update rw screen
      document.getElementById('rw-title').textContent = (language === 'en') ? "Are you using a recharging well?" : "Χρησιμοποιείται πηγάδι επαναφοράς;";
