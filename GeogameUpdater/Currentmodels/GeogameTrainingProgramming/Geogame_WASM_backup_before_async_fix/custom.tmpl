    :root {
      --white: #eff2f1;
      --black: #131200;
      --gray: #4c4c4c;
      --blue: #03256c;
      --blue2: #2541b2;
      --blue3: #3a506b;
      --red: #da4167;
      --red2: #f56476;
      --gold: #e7bb41;
      --green: #2e933c;
      --font-title: 'Handjet', sans-serif;
      --font-body: 'Roboto', sans-serif;
      --font-serif: 'PT Serif', serif;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html,
    body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: var(--black);
    }

    #game-root {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--black);
    }

    #game-canvas {
      position: relative;
      width: 1005px;
      height: 750px;
      transform-origin: center center;
      background: var(--blue);
      overflow: hidden;
      user-select: none;
    }

    #loading-screen {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(3, 37, 108, 0.98);
      z-index: 100;
      transition: opacity 0.6s ease;
    }

    #loading-screen.hidden {
      opacity: 0;
      pointer-events: none;
    }

    .loading-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }

    .loading-logo {
      font-family: var(--font-title);
      font-size: 90px;
      font-weight: 300;
      color: var(--white);
      letter-spacing: 8px;
      animation: pulse 1.4s ease-in-out infinite;
    }

    .loading-bar-wrap {
      width: 280px;
      height: 6px;
      background: rgba(255, 255, 255, 0.15);
      border-radius: 3px;
      overflow: hidden;
    }

    .loading-bar {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--red), var(--gold));
      border-radius: 3px;
      transition: width 0.15s linear;
    }

    .loading-caption {
      font-family: var(--font-body);
      font-size: 12px;
      color: rgba(239, 242, 241, 0.5);
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    @keyframes pulse {

      0%,
      100% {
        opacity: 1;
      }

      50% {
        opacity: 0.55;
      }
    }

    #main-menu {
      position: absolute;
      inset: 0;
      background: var(--blue);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.7s ease;
      pointer-events: none;
    }

    #main-menu.visible {
      opacity: 1;
      pointer-events: all;
    }

    #particles {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .particle {
      position: absolute;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.04);
      animation: floatUp linear infinite;
    }

    @keyframes floatUp {
      0% {
        transform: translateY(820px) scale(0.6);
        opacity: 0;
      }

      10% {
        opacity: 1;
      }

      90% {
        opacity: 1;
      }

      100% {
        transform: translateY(-120px) scale(1.2);
        opacity: 0;
      }
    }

    .menu-title {
      font-family: var(--font-title);
      font-size: 155px;
      font-weight: 300;
      color: var(--white);
      letter-spacing: 4px;
      line-height: 1;
      margin-bottom: 6px;
      position: relative;
      text-shadow: 0 0 60px rgba(218, 65, 103, 0.3), 0 4px 24px rgba(0, 0, 0, 0.5);
      animation: fadeDown 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: 0.1s;
    }

    @keyframes fadeDown {
      from {
        opacity: 0;
        transform: translateY(-28px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .menu-tagline {
      font-family: var(--font-body);
      font-size: 12px;
      font-weight: 500;
      color: rgba(239, 242, 241, 0.4);
      letter-spacing: 5px;
      text-transform: uppercase;
      margin-bottom: 48px;
      animation: fadeDown 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: 0.2s;
    }

    .btn-group {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      width: 210px;
      animation: fadeDown 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: 0.3s;
    }

    .menu-btn {
      width: 100%;
      height: 50px;
      font-family: var(--font-body);
      font-size: 14px;
      font-weight: 500;
      letter-spacing: 2px;
      text-transform: uppercase;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      position: relative;
      overflow: hidden;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .menu-btn::after {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(255, 255, 255, 0);
      transition: background 0.2s ease;
    }

    .menu-btn:hover {
      transform: translateY(-3px);
    }

    .menu-btn:hover::after {
      background: rgba(255, 255, 255, 0.12);
    }

    .menu-btn:active {
      transform: translateY(0) scale(0.97);
    }

    .menu-btn.primary {
      background: var(--red);
      color: var(--white);
      box-shadow: 0 4px 20px rgba(218, 65, 103, 0.3);
    }

    .menu-btn.primary:hover {
      box-shadow: 0 8px 30px rgba(218, 65, 103, 0.5);
    }

    #lang-btn {
      position: absolute;
