<body>

    <div id="transfer" align=center>
<!--        <div class="spinner" id='spinner'></div> -->
        <div class="emscripten" id="status">Downloading...</div>
        <div class="emscripten">
            <progress value="0" max="100" id="progress"></progress>
        </div>
    </div>


    <canvas class="emscripten" id="canvas"
width="1px"
height="1px"
    oncontextmenu="event.preventDefault()" tabindex=1>
    </canvas>

    <div id="html">

  <div id="game-root">
    <div id="game-canvas">

      <!-- LOADING SCREEN -->
      <div id="loading-screen">
        <div class="loading-inner">
          <div class="loading-logo">GeoGame</div>
          <div class="loading-bar-wrap">
            <div class="loading-bar" id="loading-bar"></div>
          </div>
          <div class="loading-caption" id="loading-caption">Initialising...</div>
        </div>
      </div>

      <!-- MAIN MENU -->
      <div id="main-menu">
        <div id="particles"></div>
        <h1 class="menu-title">GeoGame</h1>
        <p class="menu-tagline">Geothermal Network Puzzle</p>
        <div class="btn-group">
          <button class="menu-btn primary" id="btn-play" onclick="onPlay()">Play</button>
          <button class="menu-btn primary" id="btn-instructions" onclick="showInstructions()">Instructions</button>
          <button class="menu-btn primary" id="btn-highscores" onclick="showHighScores()">High Scores</button>
          <button class="menu-btn primary" id="btn-exam" onclick="onExam()">Exam</button>
        </div>
        <button id="lang-btn" onclick="toggleLanguage()" title="Toggle language EN / GR">
          <span id="lang-flag">&#127468;&#127463;</span>
        </button>
        <button id="bug-btn" onclick="bugReport()" title="Report a bug">&#128027;</button>
        <div class="credits">
          <a onclick="openLink('https://linktr.ee/ykontos')">Yiannis Kontos</a>
          <a onclick="openLink('https://linktr.ee/kkoutrid')">Konstantinos Koutridis</a>
        </div>
        <span class="company-credit">yiakou-games</span>
      </div>

      <!-- INSTRUCTIONS SCREEN -->
      <div class="modal-overlay" id="screen-instructions">
        <button class="back-btn" onclick="closeModal('screen-instructions')">Back</button>
        <h2 class="modal-title">Welcome to GeoGame!</h2>
        <div class="modal-body">
          <p class="modal-section-title">Grading</p>
          <p class="modal-text">Your solution will be graded primarily based on how much money you have spent.</p>
          <p class="modal-text">Money is spent by choosing pipes (different price per pipe type) and making Q and T
            corrections.</p>
          <p class="modal-section-title">Gameplay</p>
          <p class="modal-text">Always start above the pumping well. To place a pipe, click on an empty square next to
            an already existing pipe.</p>
          <p class="modal-text">When you click on a square, a dropdown list of pipes will appear. Choose your pipe and
            place it on the square.</p>
          <p class="modal-text">When needed, type the Q of the pipeline in the white pop-up box.</p>
          <p class="modal-text">Mistakes on T and Q cost a lot. If you go broke it is <strong>GAME OVER!</strong></p>
          <p class="modal-text">Watch the top-right of the game screen for information about houses.</p>
          <p class="modal-section-title">Tips</p>
          <p class="modal-text">You can RIGHT CLICK on a placed pipe to see its pipeline and T value.</p>
          <p class="modal-text">All your Q and T information for each pipeline is displayed to the right of the grid.
          </p>
        </div>
      </div>

      <!-- LEVEL SELECTION SCREEN -->
      <div class="modal-overlay" id="screen-levels">
        <button class="back-btn" onclick="closeModal('screen-levels')">Back</button>
        <h2 class="modal-title">Choose Level</h2>
        <div class="level-grid" id="level-grid"></div>
      </div>

      <!-- PRE-GAME SETUP: STARTING Q -->
      <div class="modal-overlay" id="screen-setup-q">
        <button class="back-btn" onclick="openModal('screen-levels'); closeModal('screen-setup-q');">Back</button>
        <div id="scenario-text-container"
          style="max-width: 800px; text-align: left; margin-bottom: 30px; font-family: var(--font-body); font-size: 16px; color: var(--white); line-height: 1.6; margin-top: 50px;">
          <!-- Filled by JS -->
        </div>
        <div style="display: flex; gap: 10px; align-items: center; margin-top: 20px;">
          <label for="input-starting-q"
            style="color: var(--white); font-family: var(--font-body); font-size: 24px; font-weight: 700;">Q1:</label>
          <input type="number" id="input-starting-q"
            style="width: 120px; height: 45px; font-size: 20px; text-align: center; border-radius: 4px; border: 2px solid var(--black); font-family: var(--font-body); font-weight: 700;">
          <button class="menu-btn primary" style="width: 120px; height: 45px;"
            onclick="submitStartingQ()">Submit</button>
        </div>
        <div id="mini-grid-container" style="display: flex; justify-content: center; margin-top: 20px;">
          <div id="mini-grid"
            style="width: 272px; height: 272px; background: white; border: 2px solid black; display: grid; grid-template-columns: repeat(17, 1fr); grid-template-rows: repeat(17, 1fr); pointer-events: none;">
          </div>
        </div>
      </div>

      <!-- PRE-GAME SETUP: RECHARGING WELL -->
      <div class="modal-overlay" id="screen-setup-rw">
        <button class="back-btn" onclick="openModal('screen-setup-q'); closeModal('screen-setup-rw');">Back</button>
        <h2 class="modal-title" id="rw-title" style="margin-top: 150px; font-size: 32px;">Are you using a recharging
          well?</h2>
        <div style="display: flex; gap: 30px; margin-top: 40px;">
